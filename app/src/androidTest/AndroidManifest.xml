        android:targetPackage="${targetAppId}" />
    <instrumentation android:name="dev.linkisland.app.fixture.ReturnStackInstrumentation"
        android:targetPackage="${targetAppId}" />
    <instrumentation android:name="dev.linkisland.app.fixture.RecoveryInstrumentation"
        android:targetPackage="${targetAppId}" />
    <instrumentation android:name="dev.linkisland.app.fixture.BridgeRecoveryInstrumentation"
        android:targetPackage="${targetAppId}" />
    <instrumentation android:name="dev.linkisland.app.fixture.PromptDurationInstrumentation"
        android:targetPackage="${targetAppId}" />
